{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        }
    },
    "archinstall_language": "English",
    "bootloader_config": {
        "bootloader": "Grub"
    },
    "custom_commands": [],
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [
            {
                "device": "/dev/nvme0n1",
                "wipe": true,
                "partitions": [
                    {
                        "boot": true,
                        "mountpoint": "/boot",
                        "size": "512MiB",
                        "type": "boot",
                        "filesystem": {
                            "format": "fat32"
                        }
                    },
                    {
                        "mountpoint": "/",
                        "size": "100%",
                        "type": "primary",
                        "filesystem": {
                            "format": "btrfs",
                            "mount_options": [
                                "compress=zstd"
                            ]
                        }
                    }
                ]
            }
        ]
    },
    "firmware_optdeps": [],
    "hostname": "archlinux",
    "kernels": [
        "linux"
    ],
    "locale_config": {
        "console_font": "default8x16",
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US"
    },
    "mirror_config": {
        "custom_repositories": [
            {
                "name": "myrepo",
                "sign_check": "Required",
                "sign_option": "TrustAll",
                "url": "https://myrepo.com/$repo/os/$arch"
            }
        ],
        "custom_servers": [
            {
                "url": "https://mymirror.com/$repo/os/$arch"
            }
        ],
        "mirror_regions": {
            "Australia": [
                "http://archlinux.mirror.digitalpacific.com.au/$repo/os/$arch"
            ]
        },
        "optional_repositories": [
            "testing"
        ]
    },
    "network_config": {
        "nics": [
            {
                "dhcp": true,
                "dns": [
                    "192.168.1.1",
                    "9.9.9.9"
                ],
                "gateway": "192.168.1.1",
                "iface": "eno1",
                "ip": "192.168.1.15/24"
            }
        ],
        "type": "manual"
    },
    "ntp": true,
    "packages": [],
    "pacman_config": {
        "color": false,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": "All open-source",
        "greeter": "sddm",
        "profile": {
            "custom_settings": {
                "KDE Plasma": {}
            },
            "details": [
                "KDE Plasma"
            ],
            "main": "Desktop"
        }
    },
    "script": "guided",
    "services": [],
    "swap": {
        "algorithm": "zstd",
        "enabled": true
    },
    "timezone": "UTC",
    "version": "Archinstall version not found"
}